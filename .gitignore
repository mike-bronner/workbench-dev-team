# Claude Code ephemeral agent worktrees
.claude/worktrees/
memory/

# gh CLI machine state — never publish (contains a device identifier)
.local/

# The engine lays the mod API's type declarations here each time it loads this
# folder as a plugin (a --plugin-dir session). They are written per Claude Code
# build, so they are never committed. tsconfig.json extends the tsconfig inside.
.claude-plugin/types/
